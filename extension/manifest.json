{
  "manifest_version": 3,
  "name": "LeakTrace (local development)",
  "version": "0.3.0",
  "description": "Create LeakTrace signup markers and see unverified community reports for the active website using a local LeakTrace backend.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "LeakTrace",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:*"
  }
}
