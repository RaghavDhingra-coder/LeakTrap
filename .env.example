# Example LeakTrace configuration.
# These are placeholders, NOT working credentials. Export real values in your
# shell (or copy to .env, which is git-ignored). Never commit real values.
# The application starts without a .env file.

LEAKTRACE_ENV=development
LEAKTRACE_LOG_LEVEL=INFO
# "full" (default): every API and the local dashboard. "ingest": only /health,
# /health/ready and POST /ingest/email, for the public deployment (Dockerfile).
LEAKTRACE_APP_MODE=full

# PostgreSQL via the Psycopg 3 driver. Required for database access and Alembic.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/leaktrace

# Optional connection-pool tuning (defaults shown).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Signup alias generation. Aliases look like PREFIX.abcd@DOMAIN (or abcd@DOMAIN
# without a prefix). Use a domain you control; LeakTrace does not set up mail
# routing for it. If unset, signups can only be created with generate_alias=false.
LEAKTRACE_ALIAS_DOMAIN=aliases.example.com
LEAKTRACE_ALIAS_PREFIX=
LEAKTRACE_ALIAS_SUFFIX_LENGTH=8
LEAKTRACE_MARKER_MAX_RETRIES=5

# Email ingestion (POST /ingest/email). The Cloudflare Worker sends this secret
# as a Bearer token. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters. Ingestion is disabled while it is unset.
LEAKTRACE_INGEST_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
LEAKTRACE_INGEST_MAX_BYTES=16384

# Local dashboard at /dashboard. It has no authentication, so it only answers
# requests from this machine. Defaults to on when LEAKTRACE_ENV=development.
LEAKTRACE_DASHBOARD_ENABLED=true

# Accounts and sessions. Generate the secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Required outside development (used to hash rate-limit identifiers).
LEAKTRACE_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
LEAKTRACE_SESSION_IDLE_HOURS=12
LEAKTRACE_SESSION_MAX_DAYS=7
LEAKTRACE_EXTENSION_TOKEN_HOURS=8
# Secure cookies need HTTPS. Defaults: off in development, on elsewhere.
LEAKTRACE_COOKIE_SECURE=false
# Unverified accounts can sign in only in development unless set explicitly.
LEAKTRACE_ALLOW_UNVERIFIED_LOGIN=true
# No email provider is integrated yet; leave unset (no emails are sent).
LEAKTRACE_EMAIL_DELIVERY=

# Separate, disposable database for integration tests. The tests DROP and
# recreate LeakTrace tables here, so never point it at real data. The database
# name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/leaktrace_test
